@startuml
!include <C4/C4_Context>

title Africa Delivery — C4 Context (MVP)

Person(buyer, "Покупатель", "Ищет, покупает и отслеживает товары через мобильные сети с низкой пропускной способностью")
Person(seller, "Продавец", "Поставляет товары, получает информацию о заказах и расчетах")
Person(ops, "Операционный отдел", "Онбордит продавцов, модерирует каталог и обрабатывает исключения")
Person(exec, "CEO / Аналитик", "Мониторит KPI запуска и бизнес-результаты")

System(ad, "Africa Delivery Marketplace", "Mobile-first маркетплейс: каталог, заказы, партнерские платежи, фулфилмент и уведомления")

System_Ext(mpesa, "M-Pesa", "Лицензированный провайдер мобильных платежей")
System_Ext(flutterwave, "Flutterwave", "Лицензированный платежный провайдер")
System_Ext(paystack, "Paystack", "Лицензированный платежный провайдер / вариант для последующего запуска")
System_Ext(sendbox, "Sendbox", "Логистический провайдер в Нигерии")
System_Ext(sendy, "Sendy", "Логистический провайдер в Кении")
System_Ext(whatsapp, "WhatsApp Business API", "Канал обмена сообщениями с продавцами и клиентами")
System_Ext(gateway, "SMS / USSD шлюз", "Канал уведомлений и работы с кнопочными телефонами")

Rel(buyer, ad, "Ищет в каталоге, оформляет и отслеживает заказы", "HTTPS / PWA")
Rel(seller, ad, "Предоставляет каталог/инвентарь; получает статусы", "HTTPS, WhatsApp")
Rel(ops, ad, "Управляет продавцами, каталогом, заказами и исключениями", "HTTPS")
Rel(exec, ad, "Просматривает дашборд запуска", "HTTPS")

Rel(ad, mpesa, "Инициирует платежи/возвраты и получает вебхуки статусов", "HTTPS/JSON")
Rel(ad, flutterwave, "Инициирует платежи/возвраты и получает вебхуки статусов", "HTTPS/JSON")
Rel(ad, paystack, "Инициирует платежи/возвраты и получает вебхуки статусов", "HTTPS/JSON")
Rel(ad, sendbox, "Передает заказы в Нигерии и получает обновления трекинга", "HTTPS/JSON")
Rel(ad, sendy, "Передает заказы в Кении и получает обновления трекинга", "HTTPS/JSON")
Rel(ad, whatsapp, "Отправляет одобренные сообщения и поддерживает процессы помощи продавцам", "HTTPS/JSON")
Rel(ad, gateway, "Отправляет SMS и обменивается USSD-сессиями", "HTTPS/SMPP/USSD")

SHOW_LEGEND()
@enduml
